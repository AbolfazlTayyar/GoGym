DB_HOST=localhost
DB_PORT=5432
DB_USER=gogym
DB_PASSWORD=changeme
DB_NAME=gogym
DB_SSLMODE=disable

APP_ENV=development

# Comma-separated IPs/CIDRs of reverse proxies allowed to set X-Forwarded-For; empty trusts none.
TRUSTED_PROXIES=

SERVER_PORT=8080

JWT_SECRET=changeme
JWT_EXPIRY=24h

# Go module proxy for the Docker build, for servers where proxy.golang.org is blocked (e.g. https://goproxy.cn,https://goproxy.io,direct); empty uses Go's default.
GOPROXY=
